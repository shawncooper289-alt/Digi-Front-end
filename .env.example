NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Or use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY instead of NEXT_PUBLIC_SUPABASE_ANON_KEY

# Server only. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key


# Stripe Payment Links. Configure each link in Stripe to redirect after payment to:
# https://www.digimark101.com/checkout-success?plan=<plan-slug>
STRIPE_CHECKOUT_LAUNCH_URL=https://buy.stripe.com/your-launch-link
STRIPE_CHECKOUT_GROWTH_URL=https://buy.stripe.com/your-growth-link
STRIPE_CHECKOUT_PREMIUM_URL=https://buy.stripe.com/your-premium-link
STRIPE_CHECKOUT_ELITE_URL=https://buy.stripe.com/your-elite-link
STRIPE_CHECKOUT_WHITE_LABEL_PARTNER_URL=https://buy.stripe.com/your-partner-link
STRIPE_CHECKOUT_WHITE_LABEL_ENTERPRISE_URL=https://buy.stripe.com/your-enterprise-link


# Server only. Powers Ava Skye responses through Vercel AI Gateway.
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
AI_GATEWAY_MODEL=openai/gpt-4o-mini
